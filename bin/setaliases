#!/usr/bin/env php
<?php

$daily = false;
$time_start = microtime(true);
$today = date('Y-m-d');
$cache_dir = __DIR__ . '/../cache';
define('IN_PROGRESS_PATH', realpath($cache_dir) . '/.in-progress');

function stop(int $exit_code = 0, ?string $message = null): void {
	unlink(IN_PROGRESS_PATH);
	if (!is_null($message)) {
		echo $message . PHP_EOL;
	}
	exit($exit_code);
}

if (file_exists(IN_PROGRESS_PATH)) {
	// Already in proggress, probably in another tab.
	exit(0); // do not use stop() here.
}
file_put_contents(IN_PROGRESS_PATH, 1);


// Link required
if (!isset($argv[1])) {
	stop(1, 'Error: Link needed.');
	exit; // phpstan...
}

if ($argv[1] === '--daily') {
	if (!isset($argv[2])) {
		stop(1, 'Error: Link needed.');
	}
	$link = $argv[2];
	$daily = true;
} else {
	$link = $argv[1];
}

// Only works on Windows
if (PHP_OS != 'WINNT') {
	stop(1, 'Error: This only works on Windows.');
}


$cache_link_path = $cache_dir . '/' . sha1($link) . '.json';
$cache_content = [];

// Only run once daily if the '--daily' argument is set. Per link.

if ($daily && file_exists($cache_link_path)) {
	$cache_content = json_decode(file_get_contents($cache_link_path) ?: '', true);

	if (isset($cache_content['last_run_date']) && ($cache_content['last_run_date'] === $today)) {
		stop(0);
	}
}

echo 'Running setaliases...';
$content = @file_get_contents($link) ?: '';
$sha1_new_content = sha1($content);


// If content hasn't changed since last run, we can exit.
if (isset($cache_content['sha1_content']) && ($cache_content['sha1_content'] === $sha1_new_content)) {
	// no changes since last fetch.
	stop(0, ' Done. [' . round(microtime(true) - $time_start, 2) . 'ms]');
}


// Write to cache.
file_put_contents($cache_link_path, json_encode([
	'last_run_date' => $today,
	'sha1_content' => $sha1_new_content,
]));


if (!$content) {
	stop(1, 'Error: Could not access URL.');
}


$lines = explode("\n", $content);

foreach ($lines as $line) {
	$line = trim($line);

	if (substr($line, 0, 5) != 'alias') {
		// Skip. Not an alias command.
		continue;
	}

	$line = str_replace(["'", "sudo "], "", $line);
	$line = str_replace('&&', '$t', $line);
	$line = str_replace('|', '$b', $line);

	if (empty($line)) {
		// Dont handle empty lines.
		continue;
	}

	$alias = str_replace('alias ', '', explode('=', $line)[0]);
	if (strpos($alias, '..') !== false) {
		// Skip dots. Because they bug and delete other aliases in Cmder.
		continue;
	}

	// Append "$*" if not already there, to allow arguments.
	// This is only needed on Windows, not linux.
	if (substr($line, -2) != '$*') {
		$line .= ' $*';
	}

	// Run alias command.
	passthru($line);
}


stop(0, ' Done. [' . round(microtime(true) - $time_start, 2) . 'ms]');
